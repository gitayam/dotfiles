<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LiteLLM proxy for cc-vibe. __HOME__ is replaced at install
     (scripts/install-claude-aliases.sh); launchd does not expand ~ or $HOME. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.vibe.litellm</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.vibe/run-litellm.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/.vibe</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Don't spin if a key is missing: retry at most every 30 s -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.vibe/logs/litellm.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.vibe/logs/litellm.log</string>
</dict>
</plist>
