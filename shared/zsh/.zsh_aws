# AWS Power Functions for Zsh
# Enhanced by Gemini

# ==============================================================================
# Configuration & Core Functions
# ==============================================================================

# Unalias existing aws aliases to prevent conflicts
unalias aws_check_profile aws_list_profiles aws_use_profile aws_ssm_session 2>/dev/null

# No aws binary (this Mac has none): run the official CLI through uvx
unset -f aws 2>/dev/null
if ! command -v aws &>/dev/null && command -v uvx &>/dev/null; then
    aws() { uvx --quiet --from awscli aws "$@"; }
fi

# Read --profile/--region from a helper's arguments, at call time, so a later
# `export AWS_PROFILE=...` counts. Leaves the other arguments in _AWS_ARGS:
# every helper runs `_aws_env "$@"; set -- "${_AWS_ARGS[@]}"`.
# No default profile: an unset profile is passed to the CLI as unset, never
# forced to "default" (on this Mac that is the Muse account).
_aws_env() {
    _AWS_PROFILE=${AWS_PROFILE:-}
    _AWS_REGION=${AWS_REGION:-}
    _AWS_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile) _AWS_PROFILE="$2"; shift 2 ;;
            --region) _AWS_REGION="$2"; shift 2 ;;
            *) _AWS_ARGS+=("$1"); shift ;;
        esac
    done
}

# AWS CLI call with the profile and region chosen by _aws_env, if any
_aws() {
    local -a opts=()
    [[ -n "$_AWS_PROFILE" ]] && opts+=(--profile "$_AWS_PROFILE")
    [[ -n "$_AWS_REGION" ]] && opts+=(--region "$_AWS_REGION")
    aws "${opts[@]}" "$@"
}

# ==============================================================================
# Profile & Session Management
# ==============================================================================

# List available AWS profiles from ~/.aws/config and ~/.aws/credentials
aws_list_profiles() {
    _aws_env "$@"; set -- "${_AWS_ARGS[@]}"
    echo "👤 Available AWS Profiles:"
    profiles=$(_aws configure list-profiles)
    
    if [[ -z "$profiles" ]]; then
        echo "   No profiles found."
        return
    fi
    
    while read -r profile; do
        if [[ "$profile" == "$_AWS_PROFILE" ]]; then
            echo "   ✓ $profile (active)"
        else
            echo "     $profile"
        fi
    done <<< "$profiles"
}

# Switch active AWS profile
aws_use_profile() {
    _aws_env "$@"; set -- "${_AWS_ARGS[@]}"
    if [[ -z "$1" ]]; then
        echo "Usage: aws_use_profile <profile_name>"
        aws_list_profiles
        return 1
    fi
    export AWS_PROFILE="$1"
    echo "✅ Switched to AWS profile: $AWS_PROFILE"
    aws_check_profile
}

# Check the status of the current or specified profile
aws_check_profile() {
    _aws_env "$@"; set -- "${_AWS_ARGS[@]}"
    echo "\n🔍 Checking status for profile: $_AWS_PROFILE in region $_AWS_REGION..."
    
    if ! _aws sts get-caller-identity --query "Account" --output text &>/dev/null; then
        echo "Error: Failed to authenticate with profile '$_AWS_PROFILE'."
        echo "Please check your credentials or run 'aws configure --profile ${_AWS_PROFILE:-<name>}'."
        return 1
    fi
    
    local identity=$(_aws sts get-caller-identity)
    local account=$(echo "$identity" | jq -r .Account)
    local user_id=$(echo "$identity" | jq -r .UserId)
    local arn=$(echo "$identity" | jq -r .Arn)
    
    echo "✓ Authentication successful!"
    echo "   Account: $account"
    echo "   UserID:  $user_id"
    echo "   ARN:     $arn"
}

# ==============================================================================
# EC2 Instance Management
# ==============================================================================

# List EC2 instances with a clean, readable table format
aws_ec2_instances() {
    _aws_env "$@"; set -- "${_AWS_ARGS[@]}"
    echo "Listing EC2 instances in region $_AWS_REGION..."
    
    _aws ec2 describe-instances --query 'Reservations[*].Instances[*].[InstanceId,InstanceType,State.Name,PublicIpAddress,PrivateIpAddress,Tags[?Key==`Name`].Value|[0]]' --output text | column -t -s $'	' | sed '1s/^/ID\tTYPE\tSTATE\tPUBLIC_IP\tPRIVATE_IP\tNAME\n/'
}

# Start an interactive SSM session with an EC2 instance
aws_ssm_session() {
    _aws_env "$@"; set -- "${_AWS_ARGS[@]}"
    if [[ -z "$1" ]]; then
        echo "Usage: aws_ssm_session <instance_id>"
        echo "Starts an interactive shell session with an EC2 instance using SSM."
        aws_ec2_instances "$@"
        return 1
    fi
    
    local instance_id="$1"
    echo "Starting SSM session with $instance_id..."
    _aws ssm start-session --target "$instance_id"
}

# ==============================================================================
# S3 Bucket Management
# ==============================================================================

# A more user-friendly 'ls' for S3 buckets and objects
aws_s3_ls() {
    _aws_env "$@"; set -- "${_AWS_ARGS[@]}"
    local s3_path="$1"
    
    if [[ -z "$s3_path" ]]; then
        echo "Listing all S3 buckets..."
        _aws s3 ls
        return
    fi

    # Ensure path ends with a slash if it's a "directory"
    if [[ "$s3_path" != */ && -n "$s3_path" ]]; then
        if _aws s3 ls "$s3_path/" &>/dev/null; then
            s3_path="$s3_path/"
        fi
    fi
    
    echo "Listing contents of $s3_path..."
    _aws s3 ls "$s3_path"
}

# ==============================================================================
# CloudWatch Logs
# ==============================================================================

# Fetch and follow logs from a CloudWatch log group
aws_cw_logs() {
    _aws_env "$@"; set -- "${_AWS_ARGS[@]}"
    if [[ -z "$1" ]]; then
        echo "Usage: aws_cw_logs <log_group_name> [--follow]"
        echo "\nAvailable log groups:"
        _aws logs describe-log-groups --query 'logGroups[*].logGroupName' --output text | tr '\t' '\n'
        return 1
    fi
    
    local log_group="$1"
    local follow_flag=""
    if [[ "$2" == "--follow" ]]; then
        follow_flag="--follow"
    fi
    
    echo "Fetching logs for $log_group..."
    _aws logs tail "$log_group" $follow_flag
}


# ==============================================================================
# Help & Initialization
# ==============================================================================

aws_help() {
    echo "AWS Power Functions for Zsh"
    echo "A collection of helper functions to make working with the AWS CLI easier."
    echo ""
    echo "Profile & Session Management:"
    echo "  aws_list_profiles              - List all configured AWS profiles."
    echo "  aws_use_profile <profile>     - Switch the active AWS profile for the current session."
    echo "  aws_check_profile              - Check authentication status for the current profile."
    echo ""
    echo "EC2 Instance Management:"
    echo "  aws_ec2_instances              - List EC2 instances with a clean, readable table format."
    echo "  aws_ssm_session <instance_id> - Start an interactive SSM session with an instance."
    echo ""
    echo "S3 Bucket Management:"
    echo "  aws_s3_ls [s3://path]          - List S3 buckets or objects in a bucket."
    echo ""
    echo "CloudWatch Logs:"
    echo "  aws_cw_logs <group> [--follow]- Fetch and optionally follow logs from a CloudWatch log group."
    echo ""
    echo "Note: Most commands accept --profile <p> and --region <r> arguments."
}

# Initial message to let the user know the functions are loaded.
echo "⚡️ AWS Power Functions loaded. Type 'aws_help' for a list of commands."

