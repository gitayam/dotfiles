# Fuzzy-search your shell history and re-run a command
fhist() {
  local cmd
  cmd=$(fc -l 1 | sed 's/ *[0-9]* *//' | fzf --height 40% --reverse) && print -s -- "$cmd" && eval "$cmd"
}

