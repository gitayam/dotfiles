# Unalias any conflicting aliases that may have been defined in other config files
# This prevents "defining function based on alias" errors
unalias ccopy cpaste clipls clipcat clippwd clipip fhist sanitize_filename download_video \
        igtok trim_vid mkd reset_file zipfile backup cdl show_func show_alias show_help helpmenu dots \
        dl dlvid dlaudio dl720 dl1080 dlfix vcheck vfix vinfo signalfix check_video_format \
        2>/dev/null

# Disable glob expansion for these aliases to allow URLs with special characters
# This prevents "no matches found" errors when using URLs with ? or * characters
# Now you can use: dl https://example.com/video?id=123 (without quotes!)
# noglob is zsh-only; bash (the Linux loader) gets plain aliases, so quote URLs there
if [[ -n "$ZSH_VERSION" ]]; then
  alias dl='noglob download_video'  # Download a video with yt-dlp (zsh: no quotes needed around the URL)
  alias dlvid='noglob download_video'  # Download a video with yt-dlp
  alias dlaudio='noglob download_video --audio-only'  # Download only the audio with yt-dlp
  alias dl720='noglob download_video --quality 720p'  # Download a video at 720p
  alias dl1080='noglob download_video --quality 1080p'  # Download a video at 1080p
  alias dlfix='noglob download_video --check-format'  # Download a video and convert it to play in QuickTime/Signal
else
  alias dl='download_video'  # Download a video with yt-dlp (zsh: no quotes needed around the URL)
  alias dlvid='download_video'  # Download a video with yt-dlp
  alias dlaudio='download_video --audio-only'  # Download only the audio with yt-dlp
  alias dl720='download_video --quality 720p'  # Download a video at 720p
  alias dl1080='download_video --quality 1080p'  # Download a video at 1080p
  alias dlfix='download_video --check-format'  # Download a video and convert it to play in QuickTime/Signal
fi

# Download with automatic format checking for QuickTime/macOS compatibility

# Video format checking (Signal/iOS/Android compatible)

# Check a video's compatibility with Signal/iOS/QuickTime, without converting it
vcheck() { check_video_format "$1" false; }
# Check a video and convert it if needed (to /tmp, or the folder given second)
vfix() { check_video_format "$1" true "$2"; }
alias vinfo='vcheck'      # Check a video's format without converting it
alias signalfix='vfix'    # Convert a video so it plays in Signal on every platform

# Note: igtok is a function and handles URLs correctly without noglob
  # Normalize time to hh:mm:ss.
  # If only seconds are provided (e.g. "10"), prepend "00:00:".
  # If minutes and seconds are provided (e.g. "01:00"), prepend "00:".
  normalize_time() {
    local input="$1"
    if [[ "$input" =~ ^[0-9]+$ ]]; then
      printf "00:00:%02d" "$input"
    elif [[ "$input" =~ ^[0-9]+:[0-9]+$ ]]; then
      printf "00:%s" "$input"
    else
      echo "$input"
    fi
  }

