# Fuzzy-search your shell history and re-run a command
fhist() {
  local cmd
  cmd=$(fc -l 1 | sed 's/ *[0-9]* *//' | fzf --height 40% --reverse) && print -s -- "$cmd" && eval "$cmd"
}

# ----------------------
# Video and Audio Manipulation
# These functions are used to trim videos and audio files as well as convert them to different formats

# Sanitize filename - remove spaces and special characters
sanitize_filename() {
  local filename="$1"
  # Convert to lowercase, replace spaces with underscores, keep only alphanumeric, underscores, dots, and dashes
  echo "$filename" | tr '[:upper:]' '[:lower:]' | tr ' ' '_' | tr -cd '[:alnum:]_.-'
}

# Check and fix video format compatibility issues for Signal/iOS/Android
# Converts incompatible videos to Signal-compatible format (H.264 Main + AAC + yuv420p in MP4)
check_video_format() {
  local video_file="$1"
  local auto_fix="${2:-true}"  # Auto-fix by default
  local output_path="${3:-}"    # Optional output path

  if [[ -z "$video_file" ]]; then
    echo "Usage: check_video_format <video_file> [auto_fix:true|false] [output_path]"
    echo ""
    echo "Checks video format compatibility with Signal/iOS/Android/QuickTime and fixes issues."
    echo "Ensures H.264 video, AAC audio, yuv420p pixel format, and MP4 container."
    echo "Output defaults to /tmp/, falls back to ./ or ~/ if permission issues."
    echo ""
    echo "Examples:"
    echo "  check_video_format video.mp4                      # Check and auto-fix to /tmp/"
    echo "  check_video_format video.mp4 false                # Check only, don't fix"
    echo "  check_video_format video.webm                     # Convert WebM to /tmp/"
    echo "  check_video_format video.mp4 true ~/Downloads    # Fix to specific directory"
    echo ""
    echo "Aliases:"
    echo "  vcheck / vfix / vinfo = check_video_format"
    echo "  signalfix = check_video_format (Signal-optimized)"
    return 1
  fi

  if [[ ! -f "$video_file" ]]; then
    echo "❌ Error: File not found: $video_file"
    return 1
  fi

  # Check if ffprobe and ffmpeg are installed
  if ! command -v ffprobe &>/dev/null; then
    echo "❌ ffprobe not found. Install with: brew install ffmpeg"
    return 1
  fi

  if ! command -v ffmpeg &>/dev/null; then
    echo "❌ ffmpeg not found. Install with: brew install ffmpeg"
    return 1
  fi

  echo "🔍 Analyzing video format: $video_file"
  echo ""

  # Get video information
  local video_codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$video_file" 2>/dev/null)
  local audio_codec=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$video_file" 2>/dev/null)
  local container=$(ffprobe -v error -show_entries format=format_name -of default=noprint_wrappers=1:nokey=1 "$video_file" 2>/dev/null)
  local duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$video_file" 2>/dev/null)
  local width=$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of default=noprint_wrappers=1:nokey=1 "$video_file" 2>/dev/null)
  local height=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of default=noprint_wrappers=1:nokey=1 "$video_file" 2>/dev/null)
  local pix_fmt=$(ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt -of default=noprint_wrappers=1:nokey=1 "$video_file" 2>/dev/null)
  local profile=$(ffprobe -v error -select_streams v:0 -show_entries stream=profile -of default=noprint_wrappers=1:nokey=1 "$video_file" 2>/dev/null)
  local level=$(ffprobe -v error -select_streams v:0 -show_entries stream=level -of default=noprint_wrappers=1:nokey=1 "$video_file" 2>/dev/null)
  local file_size=$(stat -f%z "$video_file" 2>/dev/null)
  local file_size_mb=$(echo "scale=2; $file_size / 1048576" | bc 2>/dev/null)

  # Display current format
  echo "📊 Current Format:"
  echo "   Container: $container"
  echo "   Video Codec: ${video_codec:-none}"
  [[ -n "$profile" ]] && echo "   H.264 Profile: $profile"
  [[ -n "$level" ]] && echo "   H.264 Level: $level"
  [[ -n "$pix_fmt" ]] && echo "   Pixel Format: $pix_fmt"
  echo "   Audio Codec: ${audio_codec:-none}"
  [[ -n "$width" && -n "$height" ]] && echo "   Resolution: ${width}x${height}"
  [[ -n "$duration" ]] && printf "   Duration: %.2f seconds\n" "$duration"
  [[ -n "$file_size_mb" ]] && printf "   File Size: %.2f MB\n" "$file_size_mb"
  echo ""

  # Check compatibility
  local needs_fix=false
  local issues=()

  # Signal/iOS/Android compatibility requirements: H.264 video, AAC audio, MP4 container, yuv420p pixel format
  if [[ "$video_codec" != "h264" && -n "$video_codec" ]]; then
    needs_fix=true
    issues+=("Video codec '$video_codec' not compatible with Signal/iOS (requires H.264)")
  fi

  # Check pixel format - CRITICAL for iOS/Android/Signal compatibility
  if [[ "$pix_fmt" != "yuv420p" && -n "$pix_fmt" && -n "$video_codec" ]]; then
    needs_fix=true
    issues+=("Pixel format '$pix_fmt' incompatible with Signal/iOS (requires yuv420p)")
  fi

  # Check H.264 profile - Main or Baseline recommended for mobile
  if [[ "$video_codec" == "h264" && -n "$profile" ]]; then
    if [[ "$profile" == *"High 4:4:4"* || "$profile" == *"High 10"* ]]; then
      needs_fix=true
      issues+=("H.264 profile '$profile' not supported on mobile devices (use Main or Baseline)")
    fi
  fi

  if [[ "$audio_codec" != "aac" && -n "$audio_codec" ]]; then
    needs_fix=true
    issues+=("Audio codec '$audio_codec' may not be compatible (prefer AAC)")
  fi

  # Signal requires MP4 container (MOV has cross-platform issues)
  if [[ "$container" != *"mp4"* ]]; then
    needs_fix=true
    if [[ "$container" == *"mov"* ]]; then
      issues+=("MOV container may not work on Signal Android (prefer MP4)")
    else
      issues+=("Container format '$container' not compatible with Signal (requires MP4)")
    fi
  fi

  # Special cases
  if [[ "$container" == *"matroska"* || "$container" == *"webm"* ]]; then
    needs_fix=true
    issues+=("MKV/WebM containers not supported by Signal/QuickTime")
  fi

  if [[ "$video_codec" == "vp9" || "$video_codec" == "vp8" || "$video_codec" == "av1" ]]; then
    needs_fix=true
    issues+=("VP8/VP9/AV1 codecs not supported by Signal/QuickTime (requires H.264)")
  fi

  if [[ "$video_codec" == "hevc" ]]; then
    needs_fix=true
    issues+=("HEVC/H.265 not supported by Signal for inline playback (requires H.264)")
  fi

  # Check file size for Signal compatibility (95 MB cross-platform limit)
  if [[ -n "$file_size_mb" ]] && (( $(echo "$file_size_mb > 95" | bc -l) )); then
    echo "⚠️  WARNING: File size (${file_size_mb} MB) exceeds Signal's cross-platform limit (95 MB)"
    echo "   Signal may compress or reject this video. Consider reducing quality."
    echo ""
  fi

  # Report issues
  if [[ ${#issues[@]} -eq 0 ]]; then
    echo "✅ Video format is compatible with Signal/iOS/Android/QuickTime!"
    echo "   No conversion needed."
    return 0
  fi

  echo "⚠️  Compatibility Issues Found:"
  for issue in "${issues[@]}"; do
    echo "   • $issue"
  done
  echo ""

  # Ask to fix if not auto-fixing
  if [[ "$auto_fix" != "true" ]]; then
    echo "Run with auto_fix=true to convert, or use:"
    echo "  check_video_format \"$video_file\" true"
    return 1
  fi

  # Determine output directory with fallback logic
  local input_name=$(basename "$video_file")
  local input_base="${input_name%.*}"
  local output_dir=""
  local tried_locations=()

  # Function to test if directory is writable
  _test_write_permission() {
    local test_dir="$1"
    local test_file="${test_dir}/.write_test_$$"

    if [[ ! -d "$test_dir" ]]; then
      return 1
    fi

    if touch "$test_file" 2>/dev/null; then
      rm -f "$test_file" 2>/dev/null
      return 0
    else
      return 1
    fi
  }

  # Try user-specified path first
  if [[ -n "$output_path" ]]; then
    # Expand ~ to home directory
    output_path="${output_path/#\~/$HOME}"

    if _test_write_permission "$output_path"; then
      output_dir="$output_path"
      echo "📁 Using specified output directory: $output_dir"
    else
      tried_locations+=("$output_path (no write permission)")
    fi
  fi

  # Try /tmp/ if no output dir yet
  if [[ -z "$output_dir" ]]; then
    if _test_write_permission "/tmp"; then
      output_dir="/tmp"
      echo "📁 Using /tmp/ for output"
    else
      tried_locations+=("/tmp (no write permission)")
    fi
  fi

  # Fall back to current directory
  if [[ -z "$output_dir" ]]; then
    if _test_write_permission "."; then
      output_dir="."
      echo "📁 Falling back to current directory"
    else
      tried_locations+=("./ (no write permission)")
    fi
  fi

  # Fall back to home directory
  if [[ -z "$output_dir" ]]; then
    if _test_write_permission "$HOME"; then
      output_dir="$HOME"
      echo "📁 Falling back to home directory"
    else
      tried_locations+=("~/ (no write permission)")
    fi
  fi

  # If still no writable location found, error out
  if [[ -z "$output_dir" ]]; then
    echo "❌ Error: Cannot find writable directory for output"
    echo "Tried locations:"
    for loc in "${tried_locations[@]}"; do
      echo "  • $loc"
    done
    return 1
  fi

  # Create output filename
  local output_file="${output_dir}/${input_base}_fixed.mp4"

  # Check if output already exists
  if [[ -f "$output_file" ]]; then
    echo "⚠️  Output file already exists: $output_file"
    printf '%s' "Overwrite? (y/n) "; read -r REPLY  # not read -p: zsh reads a coprocess
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      echo "Aborted."
      return 1
    fi
  fi

  echo "🔧 Converting to Signal/iOS/Android-compatible format..."
  echo "   Output: $output_file"
  echo ""

  # Convert with Signal-optimized settings
  # -c:v libx264 = H.264 video codec (required by Signal)
  # -profile:v main = Main profile for mobile compatibility
  # -level 3.1 = Supports up to 720p (auto-detects higher for 1080p)
  # -pix_fmt yuv420p = Pixel format required by iOS/Android
  # -preset medium = encoding speed (ultrafast, fast, medium, slow, slower)
  # -crf 23 = quality (0-51, lower = better quality, 23 is default)
  # -c:a aac = AAC audio codec (required by Signal)
  # -b:a 128k = audio bitrate (recommended for mobile)
  # -ac 2 = stereo audio
  # -movflags +faststart = optimize for streaming/quick preview (moov atom at start)

  local start_time=$(date +%s)

  if ffmpeg -i "$video_file" \
    -c:v libx264 \
    -profile:v main \
    -level 3.1 \
    -pix_fmt yuv420p \
    -preset medium \
    -crf 23 \
    -c:a aac \
    -b:a 128k \
    -ac 2 \
    -movflags +faststart \
    -y \
    "$output_file"; then

    local end_time=$(date +%s)
    local elapsed=$((end_time - start_time))

    echo ""
    echo "✅ Conversion complete! (took ${elapsed}s)"
    echo ""
    echo "📊 New Format:"

    # Show new format info
    local new_video_codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$output_file" 2>/dev/null)
    local new_audio_codec=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$output_file" 2>/dev/null)

    echo "   Container: MP4"
    echo "   Video Codec: $new_video_codec"
    echo "   Audio Codec: $new_audio_codec"
    echo ""

    # Compare file sizes
    local original_size=$(stat -f%z "$video_file" 2>/dev/null || stat -c%s "$video_file" 2>/dev/null)
    local new_size=$(stat -f%z "$output_file" 2>/dev/null || stat -c%s "$output_file" 2>/dev/null)

    printf "   Original: %.2f MB\n" $((original_size / 1024.0 / 1024.0))
    printf "   New:      %.2f MB\n" $((new_size / 1024.0 / 1024.0))

    local size_diff=$((new_size - original_size))
    if [[ $size_diff -gt 0 ]]; then
      printf "   Increase: +%.2f MB\n" $((size_diff / 1024.0 / 1024.0))
    else
      printf "   Decrease: -%.2f MB\n" $((-size_diff / 1024.0 / 1024.0))
    fi

    echo ""
    echo "🎬 Fixed video: $output_file"
    echo "   You can now open it in QuickTime Player!"

    return 0
  else
    echo ""
    echo "❌ Conversion failed. Check the error messages above."
    return 1
  fi
}

# True when a yt-dlp error means "log in / send cookies"
_dlv_auth_error() {
  local re='--cookies|[Ll]og ?in|[Ss]ign in|authenticat|[Pp]rivate video|HTTP Error 40[13]|rate.?limit'
  [[ $1 =~ $re ]]
}

# Browsers whose cookies yt-dlp can read here, one per line; blocked ones are reported on stderr
_dlv_cookie_browsers() {
  local as="$HOME/Library/Application Support" cfg="$HOME/.config" name p
  local -a cands
  if [[ "$(uname -s)" == Darwin ]]; then
    cands=("brave|$as/BraveSoftware/Brave-Browser" "chrome|$as/Google/Chrome" "chromium|$as/Chromium"
           "edge|$as/Microsoft Edge" "vivaldi|$as/Vivaldi" "firefox|$as/Firefox/Profiles"
           "safari|$HOME/Library/Containers/com.apple.Safari/Data/Library/Cookies/Cookies.binarycookies")
  else
    cands=("brave|$cfg/BraveSoftware/Brave-Browser" "chrome|$cfg/google-chrome" "chromium|$cfg/chromium"
           "edge|$cfg/microsoft-edge" "vivaldi|$cfg/vivaldi" "firefox|$HOME/.mozilla/firefox"
           "firefox|$cfg/mozilla/firefox" "firefox|$HOME/snap/firefox/common/.mozilla/firefox")
  fi
  for p in "${cands[@]}"; do
    name="${p%%|*}"; p="${p#*|}"
    [[ -e "$p" ]] || continue
    # macOS privacy protection makes these unreadable even to sudo; ls/head see that, -r does not
    if [[ -d "$p" ]] && ls "$p" >/dev/null 2>&1; then echo "$name"
    elif [[ -f "$p" ]] && head -c1 "$p" >/dev/null 2>&1; then echo "$name"
    else echo "   ⚠️  $name: macOS blocks reading its cookies (sudo doesn't help). Allow your terminal app under System Settings → Privacy & Security → Full Disk Access, then restart the terminal." >&2
    fi
  done
}

# The video-sniff helper (shared/bin), or nothing when it or uv is missing
_dlv_sniffer() {
  command -v uv >/dev/null 2>&1 || return 1
  if command -v video-sniff >/dev/null 2>&1; then command -v video-sniff
  elif [[ -x "$HOME/Git/dotfiles/shared/bin/video-sniff" ]]; then echo "$HOME/Git/dotfiles/shared/bin/video-sniff"
  else return 1
  fi
}

# Download a video or audio with yt-dlp; on a login wall retries with browser cookies, then sniffs the page
download_video() {
  # Usage: download_video URL [options]   (options before or after the URL)
  #   --output/-o NAME        Output filename without extension (default: the title)
  #   --output-dir/-d DIR     Output directory (default: /tmp, then ./, then ~)
  #   --start/-s TIME         Download from TIME (HH:MM:SS, MM:SS or seconds)
  #   --end/-e TIME           Download up to TIME
  #   --quality/-q QUALITY    best, 1080p, 720p, 480p, 360p, worst
  #   --format/-f FORMAT      Re-encode to this container (mp4, webm, mkv, ...)
  #   --audio-only/-a         Audio only, as mp3
  #   --subtitles/-sub        Subtitles too (--language/-l LANG, default en)
  #   --cookies FILE          Netscape cookie file (default: $DL_COOKIES)
  #   --browser NAME[:PROF]   Use this browser's cookies (default: $DL_BROWSER)
  #   --sniff                 Skip yt-dlp's page parsing; find the stream with a headless browser
  #   --no-fallback           Don't retry with browser cookies or the headless browser
  #   --no-sanitize           Keep the original filename
  #   --check-format          Always run the Signal/QuickTime format check
  local url="" output_filename="" start_time="" end_time="" quality="best" format=""
  local subtitles=false language="en" audio_only=false sanitize=true check_format=false
  local output_dir_override="" cookies_file="${DL_COOKIES:-}" browser="${DL_BROWSER:-}"
  local fallback=true sniff_only=false
  local download_dir="" out_tmpl="" cookie_copy="" errfile="" pathfile="" sniffer=""
  local ok=false how="" err="" b="" kind="" val="" title="" name="" tries=0
  local f dir base ext new_file video_codec pix_fmt container needs_conversion fixed_file trimmed
  local -a ytdl_args browsers media files sniff_args trim_args

  if [[ $# -eq 0 ]]; then set -- --help; fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        echo "Usage: download_video URL [options]   (options may come before or after the URL)"
        echo "  --output, -o NAME        Output filename without extension (default: the title)"
        echo "  --output-dir, -d DIR     Output directory (default: /tmp, falls back to ./ or ~/)"
        echo "  --start, -s TIME         Download from TIME (HH:MM:SS, MM:SS or seconds)"
        echo "  --end, -e TIME           Download up to TIME"
        echo "  --quality, -q QUALITY    best, 1080p, 720p, 480p, 360p, worst"
        echo "  --format, -f FORMAT      Re-encode to this container (mp4, webm, mkv, ...)"
        echo "  --audio-only, -a         Audio only, as mp3"
        echo "  --subtitles, -sub        Subtitles too (--language, -l LANG; default en)"
        echo "  --cookies FILE           Netscape cookie file, e.g. from a cookies.txt extension (default: \$DL_COOKIES)"
        echo "  --browser NAME[:PROFILE] Use a browser's cookies: brave, chrome, firefox, safari, ... (default: \$DL_BROWSER)"
        echo "  --sniff                  Skip yt-dlp's page parsing; find the stream with a headless browser"
        echo "  --no-fallback            Don't retry with browser cookies or the headless browser"
        echo "  --no-sanitize            Keep the original filename (no lowercase/underscores)"
        echo "  --check-format           Always run the Signal/QuickTime format check"
        echo ""
        echo "When a download fails:"
        echo "  1. a login or bot wall (\"Account authentication is required\", \"Sign in to confirm\")"
        echo "     is retried with the cookies of each browser on this machine you can read;"
        echo "  2. anything still failing goes to video-sniff, which opens the page in headless"
        echo "     Brave/Chrome, plays it muted and downloads the HLS/DASH/MP4 stream it loads."
        echo "Videos are converted to Signal/iOS/Android-compatible H.264+AAC MP4 when needed."
        return 0
        ;;
      --output|-o) shift; output_filename="$1" ;;
      --start|-s) shift; start_time=$(normalize_time "$1") ;;
      --end|-e) shift; end_time=$(normalize_time "$1") ;;
      --quality|-q) shift; quality="$1" ;;
      --format|-f) shift; format="$1" ;;
      --subtitles|-sub) subtitles=true ;;
      --language|-l) shift; language="$1" ;;
      --audio-only|-a) audio_only=true ;;
      --no-sanitize) sanitize=false ;;
      --check-format) check_format=true ;;
      --output-dir|-d) shift; output_dir_override="$1" ;;
      --cookies) shift; cookies_file="$1" ;;
      --cookies-from-browser|--browser) shift; browser="$1" ;;
      --sniff) sniff_only=true ;;
      --no-fallback) fallback=false ;;
      http://*|https://*)
        if [[ -n "$url" ]]; then
          echo "❌ One URL at a time (got a second one: $1)"
          return 1
        fi
        url="$1"
        ;;
      -*)
        echo "❌ Unknown option: $1"
        echo "Use 'download_video --help' to see available options"
        return 1
        ;;
      *)
        echo "❌ Invalid URL: $1"
        echo "URL must start with http:// or https://"
        return 1
        ;;
    esac
    shift
  done

  if [[ -z "$url" ]]; then
    echo "❌ No URL given. Use 'download_video --help' for usage."
    return 1
  fi
  if [[ -n "$cookies_file" ]]; then
    cookies_file="${cookies_file/#\~/$HOME}"
    if [[ ! -r "$cookies_file" ]]; then
      echo "❌ Cannot read cookie file: $cookies_file"
      return 1
    fi
  fi

  if ! command -v yt-dlp >/dev/null 2>&1; then
    echo "❌ yt-dlp not found"
    if command -v brew >/dev/null 2>&1; then
      printf '%s' "Install yt-dlp with Homebrew? (y/n) "; read -r REPLY  # not read -p: zsh reads a coprocess
      [[ $REPLY =~ ^[Yy]$ ]] || return 1
      HOMEBREW_NO_ASK=1 brew install yt-dlp || return 1
    else
      echo "   Install it with: uv tool install yt-dlp   (or pipx install yt-dlp)"
      return 1
    fi
  fi

  # Output directory: --output-dir, else /tmp, ./ or ~
  if [[ -n "$output_dir_override" ]]; then
    output_dir_override="${output_dir_override/#\~/$HOME}"
    if [[ ! -d "$output_dir_override" ]]; then
      echo "❌ Error: Directory does not exist: $output_dir_override"
      return 1
    elif [[ ! -w "$output_dir_override" ]]; then
      echo "❌ Error: No write permission for: $output_dir_override"
      return 1
    fi
    download_dir="$output_dir_override"
  elif [[ -w /tmp ]]; then download_dir="/tmp"
  elif [[ -w . ]]; then download_dir="."
  elif [[ -w "$HOME" ]]; then download_dir="$HOME"
  else
    echo "❌ Error: Cannot find writable directory for download"
    return 1
  fi

  # Format choice. -S prefers H.264/AAC at the same resolution, so most videos need no re-encode.
  if [[ "$audio_only" == true ]]; then
    ytdl_args+=(-x --audio-format mp3)
  else
    # A sort limit (res:720 = "largest up to 720p") still works when a stream doesn't state
    # its height, where a [height<=720] filter fails with "Requested format is not available"
    case "$quality" in
      best)                ytdl_args+=(-f "bv*+ba/b" -S "res,fps,vcodec:h264,acodec:aac") ;;
      1080p|720p|480p|360p) ytdl_args+=(-f "bv*+ba/b" -S "res:${quality%p},fps,vcodec:h264,acodec:aac") ;;
      worst)               ytdl_args+=(-f "wv*+wa/w") ;;
      *)
        echo "❌ Unknown quality: $quality (best, 1080p, 720p, 480p, 360p, worst)"
        return 1
        ;;
    esac
    [[ -z "$format" ]] && ytdl_args+=(--merge-output-format mp4)
  fi
  [[ -n "$format" ]] && ytdl_args+=(--recode-video "$format")
  [[ "$subtitles" == true ]] && ytdl_args+=(--write-subs --convert-subs srt --sub-langs "$language")

  if [[ -n "$output_filename" ]]; then
    output_filename=$(echo "$output_filename" | tr ' ' '_' | tr -cd '[:alnum:]._-')
    out_tmpl="${download_dir}/${output_filename}.%(ext)s"
  else
    out_tmpl="${download_dir}/%(title).100B.%(ext)s"   # long titles break filesystems
  fi

  # yt-dlp writes the final path of every file here, and rewrites a --cookies file it is given,
  # so it gets a private copy and never touches the original
  errfile=$(mktemp) pathfile=$(mktemp)
  if [[ -n "$cookies_file" ]]; then
    cookie_copy=$(mktemp); chmod 600 "$cookie_copy"; cat "$cookies_file" > "$cookie_copy"
  fi

  echo "🎬 Downloading: $url"
  echo "📁 Directory:   $download_dir   ⚙️  quality=$quality${format:+, format=$format}${start_time:+, from $start_time}${end_time:+, to $end_time}"

  # Attempt 1: as given (with the cookie file or browser you named, if any)
  if [[ "$sniff_only" != true ]]; then
    if [[ -n "$cookie_copy" ]]; then how="cookie file"; set -- --cookies "$cookie_copy"
    elif [[ -n "$browser" ]]; then how="$browser cookies"; set -- --cookies-from-browser "$browser"
    else how="no cookies"; set --
    fi
    yt-dlp "${ytdl_args[@]}" "$@" -o "$out_tmpl" --print-to-file after_move:filepath "$pathfile" "$url" 2> "$errfile" && ok=true
    err=$(grep -E '^ERROR' "$errfile" | head -3 | sed 's/^ERROR: //')
    [[ "$err" == *"Operation not permitted"* ]] && \
      echo "   ⚠️  macOS blocked reading the browser's cookies (sudo doesn't help): allow your terminal app under System Settings → Privacy & Security → Full Disk Access, then restart it."

    # Attempt 2: a login/bot wall, and no cookie source named: try each readable browser
    if [[ "$ok" != true && "$fallback" == true && -z "$cookie_copy" && -z "$browser" ]] && _dlv_auth_error "$err"; then
      echo "🔐 The site wants a login: ${err%%$'\n'*}"
      browsers=()
      while IFS= read -r b; do [[ -n "$b" ]] && browsers+=("$b"); done < <(_dlv_cookie_browsers)
      if [[ ${#browsers[@]} -eq 0 ]]; then
        echo "   No readable browser cookies. Log in with a browser, or pass --cookies FILE."
      fi
      for b in "${browsers[@]}"; do
        echo "🍪 Retrying with $b's cookies (macOS may ask to let yt-dlp read \"$b Safe Storage\": Allow)"
        : > "$pathfile"
        if yt-dlp "${ytdl_args[@]}" --cookies-from-browser "$b" -o "$out_tmpl" \
             --print-to-file after_move:filepath "$pathfile" "$url" 2> "$errfile"; then
          ok=true; how="$b cookies"; break
        fi
        err=$(grep -E '^ERROR' "$errfile" | head -3 | sed 's/^ERROR: //')
        echo "   ✗ $b: ${err%%$'\n'*}"
      done
    fi
  fi

  # Attempt 3: open the page in a headless browser and download the stream it plays
  if [[ "$ok" != true && ( "$fallback" == true || "$sniff_only" == true ) ]]; then
    if sniffer=$(_dlv_sniffer); then
      echo "🧭 Looking for the stream in a headless browser (video-sniff)..."
      media=()
      title=""
      sniff_args=()
      [[ -n "$cookies_file" ]] && sniff_args=(--cookies "$cookies_file")
      while IFS=$'\t' read -r kind val; do
        case "$kind" in
          title) title="$val" ;;
          hls|dash|file) media+=("$val") ;;
        esac
      done < <("$sniffer" "${sniff_args[@]}" "$url")
      if [[ ${#media[@]} -eq 0 ]]; then
        echo "   ✗ The page loaded no video stream."
      else
        echo "   Found ${#media[@]} stream(s)${title:+ on \"$title\"}"
        if [[ -n "$output_filename" ]]; then name="$output_filename"
        else
          name=$(sanitize_filename "${title:0:100}")
          [[ -z "$name" || "$name" == "." ]] && name="video_$(date +%Y%m%d_%H%M%S)"
        fi
        tries=0
        for val in "${media[@]}"; do
          tries=$((tries + 1)); [[ $tries -gt 3 ]] && break
          echo "⬇️  ${val:0:120}"
          : > "$pathfile"
          set -- --referer "$url"
          [[ -n "$cookie_copy" ]] && set -- "$@" --cookies "$cookie_copy"
          if yt-dlp "${ytdl_args[@]}" "$@" -o "${download_dir}/${name}.%(ext)s" \
               --print-to-file after_move:filepath "$pathfile" "$val" 2> "$errfile"; then
            ok=true; how="headless browser"; break
          fi
          err=$(grep -E '^ERROR' "$errfile" | head -3 | sed 's/^ERROR: //')
          echo "   ✗ ${err%%$'\n'*}"
        done
      fi
    elif [[ "$fallback" == true || "$sniff_only" == true ]]; then
      echo "   (headless fallback unavailable: needs uv and shared/bin/video-sniff)"
    fi
  fi

  if [[ "$ok" != true ]]; then
    if [[ "$err" =~ "No video could be found" || "$err" =~ "No video formats found" ]]; then
      echo "📭 No video found at this URL (text, images or an external link only?)"
    elif [[ "$err" =~ "Unsupported URL" ]]; then
      echo "❌ Unsupported URL: yt-dlp doesn't know this site and the page played no stream"
    elif _dlv_auth_error "$err"; then
      echo "🔒 Still needs a login. Log in with a browser and pass --browser NAME, or export"
      echo "   the site's cookies to a file (a cookies.txt extension) and pass --cookies FILE."
    elif [[ "$err" =~ "Video unavailable" ]]; then
      echo "📵 Video unavailable (may be deleted or restricted)"
    elif [[ "$err" =~ "ffmpeg exited with code" ]]; then
      echo "🧱 ffmpeg failed while downloading. If 'ffmpeg -v error -i https://example.com -f null -'"
      echo "   times out while curl works, a per-app firewall (LuLu, Little Snitch) is blocking ffmpeg."
    fi
    echo "❌ Download failed${err:+: }${err%%$'\n'*}"
    [[ -n "$err" ]] || tail -3 "$errfile"
    rm -f "$errfile" "$pathfile" "$cookie_copy"
    return 1
  fi

  echo "✅ Download complete ($how)"
  files=()
  while IFS= read -r f; do [[ -n "$f" && -f "$f" ]] && files+=("$f"); done < "$pathfile"
  rm -f "$errfile" "$pathfile" "$cookie_copy"

  for f in "${files[@]}"; do
    if [[ "$sanitize" == true ]]; then
      dir="${f%/*}"; base="${f##*/}"; ext="${base##*.}"
      new_file="${dir}/$(sanitize_filename "${base%.*}" | sed -E 's/[._-]+$//').${ext}"
      if [[ "$f" != "$new_file" && ! -e "$new_file" ]]; then
        mv "$f" "$new_file" && f="$new_file"
      fi
    fi

    # Trim locally: yt-dlp's --download-sections needs ffmpeg itself on the network, which
    # a per-app firewall (LuLu) can block; this works whichever downloader fetched the file
    if [[ -n "$start_time" || -n "$end_time" ]]; then
      trim_args=()
      [[ -n "$start_time" ]] && trim_args+=(-ss "$start_time")
      [[ -n "$end_time" ]] && trim_args+=(-to "$end_time")
      if [[ "$audio_only" == true ]]; then
        trimmed="${f%.*}_trimmed.mp3"; set -- -c:a libmp3lame -q:a 2
      else
        trimmed="${f%.*}_trimmed.mp4"; set -- -c:v libx264 -pix_fmt yuv420p -c:a aac -movflags +faststart
      fi
      echo "🔪 Trimming${start_time:+ from $start_time}${end_time:+ to $end_time}"
      if ffmpeg -v error -y "${trim_args[@]}" -i "$f" "$@" "$trimmed" </dev/null; then
        echo "   Full download kept: $f"
        f="$trimmed"
      else
        echo "   ⚠️  Trim failed; keeping the full file"
      fi
    fi

    # Convert anything that won't play in Signal/iOS/Android/QuickTime
    if [[ "$audio_only" == false ]]; then
      video_codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$f" 2>/dev/null </dev/null)
      pix_fmt=$(ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt -of default=noprint_wrappers=1:nokey=1 "$f" 2>/dev/null </dev/null)
      container=$(ffprobe -v error -show_entries format=format_name -of default=noprint_wrappers=1:nokey=1 "$f" 2>/dev/null </dev/null)
      needs_conversion=false
      if [[ -n "$video_codec" ]] && [[ "$video_codec" != "h264" || "$pix_fmt" != "yuv420p" || "$container" != *mp4* ]]; then
        needs_conversion=true
      fi
      if [[ -n "$video_codec" ]] && [[ "$needs_conversion" == true || "$check_format" == true ]]; then
        echo ""
        echo "🔍 Converting to Signal/iOS/Android-compatible format..."
        echo "   Current codec: $video_codec (needs H.264), pixel format: $pix_fmt (needs yuv420p)"
        check_video_format "$f" true "$download_dir" </dev/null
        fixed_file="${f%.*}_fixed.mp4"
        [[ -f "$fixed_file" ]] && f="$fixed_file"
      elif [[ -n "$video_codec" ]]; then
        echo "✅ Already Signal/iOS/Android compatible (h264, yuv420p, mp4)"
      fi
    fi
    echo "📁 Final file: $f"
  done
  return 0
}

