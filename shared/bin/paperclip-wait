#!/usr/bin/env python3
"""paperclip-wait — wait for a Paperclip issue to finish, then print its status and comments.

  paperclip-wait SAC-12            # issue identifier or id; waits up to 300 s
  paperclip-wait SAC-12 600        # custom timeout in seconds

Exit codes: 0 done, 1 blocked or cancelled, 2 still open at the timeout, 3 API error.
Made for agents such as Hermes: one plain command instead of a polling loop
with inline scripts, which Hermes rightly asks a person to approve.
"""

import json
import os
import sys
import time
import urllib.error
import urllib.request

API = os.environ.get("PAPERCLIP_API_URL", "http://127.0.0.1:3100").rstrip("/") + "/api"
FINAL = {"done": 0, "blocked": 1, "cancelled": 1}


def get(path):
    with urllib.request.urlopen(f"{API}/{path}", timeout=20) as r:
        return json.load(r)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if len(sys.argv) > 1 else 3
    ref = sys.argv[1]
    timeout = int(sys.argv[2]) if len(sys.argv) > 2 else 300
    deadline = time.monotonic() + timeout
    while True:
        try:
            issue = get(f"issues/{ref}")
        except (urllib.error.URLError, ValueError) as e:
            print(f"paperclip-wait: cannot read issue {ref}: {e}", file=sys.stderr)
            return 3
        status = issue.get("status")
        if status in FINAL or time.monotonic() >= deadline:
            break
        time.sleep(5)
    print(f"{issue.get('identifier') or ref}: {status} ({issue.get('title', '')})")
    try:
        comments = get(f"issues/{issue['id']}/comments")
    except (urllib.error.URLError, ValueError, KeyError):
        comments = []
    if isinstance(comments, dict):
        comments = comments.get("items", [])
    for c in comments:
        print(f"- {(c.get('body') or '').strip()}")
    return FINAL.get(status, 2)


if __name__ == "__main__":
    sys.exit(main())
