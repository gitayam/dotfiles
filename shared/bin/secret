#!/bin/bash
# secret: encrypted secrets shared across your machines (sops + age).
#
# Store ($SECRETS_DIR, default ~/Git/secrets; a PRIVATE git repo or Syncthing folder):
#   devices.txt     one "name age1..." line per device allowed to decrypt
#   .sops.yaml      generated from devices.txt
#   <profile>.env   dotenv files; values encrypted, key names readable
# Device key: this machine's age private key, kept in the macOS Keychain, the
# Linux Secret Service (KeePassXC/GNOME Keyring), or, where neither exists,
# ~/.config/sops/age/keys.txt (mode 600). It is never synced.
#
#   secret init                        create this device's key and the store
#   secret pubkey                      print this device's public key
#   secret devices                     list devices that can decrypt
#   secret add-device NAME AGE_KEY     allow another device (re-encrypts every profile)
#   secret remove-device NAME          revoke a device (re-encrypts; rotate the values too)
#   secret reencrypt                   re-encrypt every profile for the devices in devices.txt
#   secret import PROFILE FILE         encrypt an existing .env file (the original is kept)
#   secret set PROFILE KEY             store one value, read from stdin or a hidden prompt
#   secret unset PROFILE KEY           remove one value
#   secret edit PROFILE                edit in $EDITOR (sops uses a private temp file)
#   secret list [PROFILE]              profiles, or the KEY names in one (never values)
#   secret get PROFILE KEY             print one value (for helpers like apiKeyHelper)
#   secret run PROFILE[,PROFILE] -- CMD [ARGS]   run CMD with those values in its environment only
#   secret env PROFILE                 KEY=value lines for a script that must load them
#                                      into a sourced shell (refuses to print to a terminal)
#   secret aws-credentials PROFILE     AWS CLI credential_process output (JSON); in ~/.aws/config:
#                                      credential_process = ~/Git/dotfiles/shared/bin/secret aws-credentials PROFILE
#   secret codex-keyring               make Codex keep its login in the OS keyring
#   secret doctor                      check tools, key, store and plaintext leftovers
#
# Values never touch disk in plaintext (except inside `secret edit`'s sops
# temp file) and never appear on a command line.

set -u
SECRETS_DIR="${SECRETS_DIR:-$HOME/Git/secrets}"
KEY_SERVICE="${SECRET_KEY_SERVICE:-dotfiles-age-key}"
KEY_FILE="${SECRET_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
# SECRET_KEY_BACKEND=keychain|secret-service|file forces a backend (tests use file).
# `secret init` records the backend it used, so later commands look in the same place.
BACKEND_FILE="$HOME/.config/sops/age/backend"
BACKEND="${SECRET_KEY_BACKEND:-$(cat "$BACKEND_FILE" 2>/dev/null)}"

die() { echo "secret: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 is not installed (macOS: brew install $2; Linux: see linux/initial_linux_setup.sh)"; }
valid_profile() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "profile names are lowercase letters, digits, - and _ ($1)"; }
valid_key() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "not a valid variable name: $1"; }
profile_file() { echo "$SECRETS_DIR/$1.env"; }

# --- Device key ------------------------------------------------------------------

pick_backend() {
  [[ -n "$BACKEND" ]] && { echo "$BACKEND"; return; }
  if [[ "$(uname -s)" == Darwin ]] && command -v security >/dev/null; then
    echo keychain
  elif command -v secret-tool >/dev/null && secret-tool search service "$KEY_SERVICE" >/dev/null 2>&1; then
    echo secret-service
  elif command -v secret-tool >/dev/null && [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    echo secret-service
  else
    echo file
  fi
}

key_exists() {
  case "$(pick_backend)" in
    keychain) security find-generic-password -a "$USER" -s "$KEY_SERVICE" >/dev/null 2>&1 ;;
    secret-service) secret-tool lookup service "$KEY_SERVICE" >/dev/null 2>&1 ;;
    file) [[ -s "$KEY_FILE" ]] ;;
  esac
}

# Point sops at this device's key without exporting the key itself
use_key() {
  key_exists || die "no device key yet; run: secret init"
  unset SOPS_AGE_KEY SOPS_AGE_KEY_FILE SOPS_AGE_KEY_CMD
  case "$(pick_backend)" in
    keychain) export SOPS_AGE_KEY_CMD="security find-generic-password -a $USER -s $KEY_SERVICE -w" ;;
    secret-service) export SOPS_AGE_KEY_CMD="secret-tool lookup service $KEY_SERVICE" ;;
    file) export SOPS_AGE_KEY_FILE="$KEY_FILE" ;;
  esac
}

# The private key, for deriving the public key; stays in this process's memory
read_private_key() {
  case "$(pick_backend)" in
    keychain) security find-generic-password -a "$USER" -s "$KEY_SERVICE" -w 2>/dev/null ;;
    secret-service) secret-tool lookup service "$KEY_SERVICE" 2>/dev/null ;;
    file) grep '^AGE-SECRET-KEY-' "$KEY_FILE" 2>/dev/null ;;
  esac
}

device_pubkey() { read_private_key | age-keygen -y 2>/dev/null; }

store_new_key() {
  local key="$1"
  case "$(pick_backend)" in
    keychain)
      # Through `security -i` on stdin, so the key is never in a process's argv
      printf 'add-generic-password -U -a "%s" -s "%s" -l "%s" -w "%s"\n' \
        "$USER" "$KEY_SERVICE" "dotfiles age key (secret)" "$key" | security -i >/dev/null 2>&1 ;;
    secret-service)
      printf '%s' "$key" | secret-tool store --label="dotfiles age key (secret)" service "$KEY_SERVICE" ;;
    file)
      mkdir -p "$(dirname "$KEY_FILE")" && chmod 700 "$(dirname "$KEY_FILE")"
      ( umask 077; printf '%s\n' "$key" > "$KEY_FILE" ) ;;
  esac
}

# --- Store --------------------------------------------------------------------------

recipients() { awk 'NF >= 2 && $1 !~ /^#/ {print $2}' "$SECRETS_DIR/devices.txt" 2>/dev/null | paste -sd, -; }

write_sops_yaml() {
  local r; r=$(recipients)
  [[ -n "$r" ]] || die "devices.txt lists no devices"
  cat > "$SECRETS_DIR/.sops.yaml" <<EOF
# Generated by \`secret\` from devices.txt; edit devices with secret add-device/remove-device
creation_rules:
  - path_regex: \\.env\$
    age: >-
      $r
EOF
}

reencrypt_all() {
  local f
  use_key
  for f in "$SECRETS_DIR"/*.env; do
    [[ -e "$f" ]] || continue
    (cd "$SECRETS_DIR" && sops updatekeys --yes --input-type dotenv "${f##*/}" >/dev/null) ||
      die "could not re-encrypt ${f##*/} (is this device one of its recipients?)"
  done
}

# Canonical KEY=value lines from a .env: drops comments, `export ` and one pair
# of surrounding quotes. Runs in memory.
normalize_env() {
  python3 -c '
import re, sys
for raw in sys.stdin.read().splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    line = re.sub(r"^export\s+", "", line)
    key, sep, val = line.partition("=")
    key = key.strip()
    if not sep or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
        print(f"secret: skipped a line that is not KEY=value", file=sys.stderr)
        continue
    val = val.strip()
    single_quoted = len(val) >= 2 and val[0] == val[-1] == "\x27"
    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"\x27":
        val = val[1:-1]
    # $VAR / ${VAR} would be stored as that text, not the value it stands for
    if not single_quoted and re.search(r"\$[{A-Za-z_]", val):
        print(f"secret: skipped {key}: it references another variable; store the real value with: secret set PROFILE {key}", file=sys.stderr)
        continue
    if "\n" in val:
        print(f"secret: skipped {key}: multi-line values are not supported", file=sys.stderr)
        continue
    print(f"{key}={val}")'
}

# Encrypt dotenv text from stdin into a profile; no plaintext file is written
encrypt_into() {
  local profile="$1" out tmp
  out=$(profile_file "$profile")
  tmp=$(mktemp "$SECRETS_DIR/.tmp.XXXXXX") || die "cannot write to $SECRETS_DIR"
  if sops encrypt --input-type dotenv --output-type dotenv --age "$(recipients)" \
       --filename-override "$profile.env" /dev/stdin > "$tmp"; then
    mv "$tmp" "$out" && chmod 600 "$out"
  else
    rm -f "$tmp"; die "encryption failed for $profile"
  fi
}

decrypt_profile() {
  local f; f=$(profile_file "$1")
  [[ -f "$f" ]] || die "no profile '$1' in $SECRETS_DIR (secret list shows them)"
  sops decrypt --input-type dotenv --output-type dotenv "$f" || die "could not decrypt $1 (this device may not be a recipient)"
}

# Record a change in the store's git history (only the files named; never pushes)
store_commit() {
  local msg="$1"; shift
  git -C "$SECRETS_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  git -C "$SECRETS_DIR" add -- "$@" 2>/dev/null
  git -C "$SECRETS_DIR" diff --cached --quiet && return 0
  git -C "$SECRETS_DIR" commit -q -m "secret: $msg" -- "$@" >/dev/null 2>&1 ||
    echo "secret: changed, but the git commit failed; commit it yourself" >&2
}

# --- Commands -------------------------------------------------------------------------

cmd_init() {
  need sops sops; need age-keygen age
  local backend key pub name
  backend=$(pick_backend)
  if key_exists; then
    echo "Device key: already in $backend."
  else
    key=$(age-keygen 2>/dev/null | grep '^AGE-SECRET-KEY-') || die "age-keygen failed"
    if ! store_new_key "$key" || ! key_exists; then
      # e.g. secret-tool present but no keyring daemon running
      [[ "$backend" == file ]] && die "could not store the key in $KEY_FILE"
      echo "Could not store the key in $backend; using $KEY_FILE (mode 600) instead."
      BACKEND=file; backend=file
      store_new_key "$key" && key_exists || die "could not store the key in $KEY_FILE"
    fi
    unset key
    echo "Device key: created in $backend."
  fi
  if [[ -z "${SECRET_KEY_BACKEND:-}" ]]; then
    mkdir -p "$(dirname "$BACKEND_FILE")" && chmod 700 "$(dirname "$BACKEND_FILE")"
    echo "$backend" > "$BACKEND_FILE"
  fi
  pub=$(device_pubkey) || die "could not derive the public key"
  mkdir -p "$SECRETS_DIR" && chmod 700 "$SECRETS_DIR"
  name=$(hostname -s 2>/dev/null || hostname)
  if grep -qs " $pub\$" "$SECRETS_DIR/devices.txt"; then
    echo "Store: this device is already listed in devices.txt."
    write_sops_yaml
  elif [[ -z "$(recipients)" ]]; then
    # The first device starts the store
    echo "# name age-public-key   (one device per line; managed by secret add-device/remove-device)" > "$SECRETS_DIR/devices.txt"
    echo "$name $pub" >> "$SECRETS_DIR/devices.txt"
    write_sops_yaml
    echo "Store: created $SECRETS_DIR with this device ($name)."
  else
    # Only a device that can already decrypt can re-encrypt the profiles for this one
    echo "Store: this device is not a recipient yet. On a device that can decrypt, run:"
    echo "  secret add-device $name $pub"
  fi
  [[ -f "$SECRETS_DIR/.gitignore" ]] || printf '.tmp.*\n*.dec\n*.plain\n' > "$SECRETS_DIR/.gitignore"
  # History for the store; a remote (private!) is yours to add
  if command -v git >/dev/null && ! git -C "$SECRETS_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$SECRETS_DIR" init -q && echo "Store: started a git repository (no remote; add a private one)."
  fi
  store_commit "init $name" .gitignore devices.txt .sops.yaml $(cd "$SECRETS_DIR" && ls *.env 2>/dev/null)
  echo ""
  echo "This device's public key (safe to share): $pub"
  echo "Keep $SECRETS_DIR in a PRIVATE repo or Syncthing folder. To allow another"
  echo "device, run there: secret init, then here: secret add-device NAME <its key>"
}

cmd_add_device() {
  local name="${1:-}" pub="${2:-}"
  [[ -n "$name" && -n "$pub" ]] || die "usage: secret add-device NAME age1..."
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "device names are letters, digits, . _ -"
  [[ "$pub" =~ ^age1[02-9ac-hj-np-z]{58}$ ]] || die "not an age X25519 public key: $pub"
  if grep -qsx "$name $pub" "$SECRETS_DIR/devices.txt"; then
    echo "$name is already listed; re-encrypting so it can read every profile."
  else
    grep -qs "^$name " "$SECRETS_DIR/devices.txt" && die "a device named $name already exists with another key"
    grep -qs " $pub\$" "$SECRETS_DIR/devices.txt" && die "that key is already listed under another name"
    echo "$name $pub" >> "$SECRETS_DIR/devices.txt"
  fi
  write_sops_yaml
  reencrypt_all
  store_commit "add device $name" devices.txt .sops.yaml $(cd "$SECRETS_DIR" && ls *.env 2>/dev/null)
  echo "Added $name; every profile is now encrypted for it too."
}

cmd_remove_device() {
  local name="${1:-}" tmp
  [[ -n "$name" ]] || die "usage: secret remove-device NAME"
  grep -qs "^$name " "$SECRETS_DIR/devices.txt" || die "no device named $name"
  tmp=$(mktemp) && grep -v "^$name " "$SECRETS_DIR/devices.txt" > "$tmp" && mv "$tmp" "$SECRETS_DIR/devices.txt"
  write_sops_yaml
  reencrypt_all
  store_commit "remove device $name" devices.txt .sops.yaml $(cd "$SECRETS_DIR" && ls *.env 2>/dev/null)
  echo "Removed $name. It can't decrypt new versions, but it may have copies of the"
  echo "old values: rotate every secret it could read (git history keeps old files too)."
}

cmd_import() {
  local profile="${1:-}" file="${2:-}"
  [[ -n "$profile" && -n "$file" ]] || die "usage: secret import PROFILE FILE"
  valid_profile "$profile"
  [[ -f "$file" ]] || die "no such file: $file"
  [[ -f "$(profile_file "$profile")" ]] && die "profile $profile exists; use secret set/edit"
  normalize_env < "$file" | encrypt_into "$profile"
  store_commit "import $profile" "$profile.env"
  echo "Encrypted $(cmd_list "$profile" | wc -l | tr -d ' ') value(s) from $file into $profile."
  echo "Check with: secret list $profile   then remove the plaintext file yourself."
}

cmd_set() {
  local profile="${1:-}" key="${2:-}" value current
  [[ -n "$profile" && -n "$key" ]] || die "usage: secret set PROFILE KEY   (value from stdin or a hidden prompt)"
  valid_profile "$profile"; valid_key "$key"
  if [[ -t 0 ]]; then
    printf 'Value for %s (hidden): ' "$key" >&2; read -rs value; echo >&2
  else
    IFS= read -r value
  fi
  [[ -n "$value" ]] || die "empty value; nothing stored"
  [[ "$value" == *$'\n'* ]] && die "multi-line values are not supported"
  current=""
  [[ -f "$(profile_file "$profile")" ]] && current=$(decrypt_profile "$profile")
  { printf '%s\n' "$current" | grep -v "^$key=" | grep -v '^$'; printf '%s=%s\n' "$key" "$value"; } | encrypt_into "$profile"
  unset value current
  store_commit "set $profile $key" "$profile.env"
  echo "Stored $key in $profile."
}

cmd_unset() {
  local profile="${1:-}" key="${2:-}" current
  [[ -n "$profile" && -n "$key" ]] || die "usage: secret unset PROFILE KEY"
  current=$(decrypt_profile "$profile")
  printf '%s\n' "$current" | grep -q "^$key=" || die "$key is not in $profile"
  printf '%s\n' "$current" | grep -v "^$key=" | grep -v '^$' | encrypt_into "$profile"
  store_commit "unset $profile $key" "$profile.env"
  echo "Removed $key from $profile."
}

cmd_list() {
  local profile="${1:-}" f
  if [[ -z "$profile" ]]; then
    for f in "$SECRETS_DIR"/*.env; do [[ -e "$f" ]] && basename "$f" .env; done
    return 0
  fi
  # Key names are stored in the clear: no decryption needed
  [[ -f "$(profile_file "$profile")" ]] || die "no profile '$profile'"
  grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$(profile_file "$profile")" | grep -v '^sops_' | cut -d= -f1
}

cmd_get() {
  local profile="${1:-}" key="${2:-}" line
  [[ -n "$profile" && -n "$key" ]] || die "usage: secret get PROFILE KEY"
  while IFS= read -r line; do
    [[ "${line%%=*}" == "$key" ]] && { printf '%s\n' "${line#*=}"; return 0; }
  done < <(decrypt_profile "$profile")
  die "$key is not in $profile"
}

cmd_run() {
  local profiles="${1:-}" line key p
  shift || true
  [[ "${1:-}" == "--" ]] && shift
  [[ -n "$profiles" && $# -gt 0 ]] || die "usage: secret run PROFILE[,PROFILE] -- COMMAND [ARGS]"
  local IFS_save="$IFS"; IFS=','
  for p in $profiles; do
    IFS="$IFS_save"
    valid_profile "$p"
    # Process substitution, not a here-string: bash writes here-strings to a temp file
    while IFS= read -r line; do
      key="${line%%=*}"
      [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      export "$key=${line#*=}"
    done < <(decrypt_profile "$p")
    IFS=','
  done
  IFS="$IFS_save"
  exec "$@"
}

# The JSON the AWS CLI and SDKs read from a credential_process, built from the
# profile's AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (and AWS_SESSION_TOKEN)
cmd_aws_credentials() {
  local profile="${1:-}" plain
  [[ -n "$profile" ]] || die "usage: secret aws-credentials PROFILE"
  [[ -t 1 ]] && die "aws-credentials prints keys for the AWS CLI; it won't print them to a terminal"
  plain=$(decrypt_profile "$profile") || exit 1
  printf '%s\n' "$plain" | python3 -I -c '
import json, sys
env = dict(l.split("=", 1) for l in sys.stdin.read().splitlines() if "=" in l)
missing = [k for k in ("AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY") if not env.get(k)]
if missing:
    sys.exit("secret: profile '"'"'%s'"'"' lacks %s" % (sys.argv[1], ", ".join(missing)))
out = {"Version": 1, "AccessKeyId": env["AWS_ACCESS_KEY_ID"], "SecretAccessKey": env["AWS_SECRET_ACCESS_KEY"]}
if env.get("AWS_SESSION_TOKEN"):
    out["SessionToken"] = env["AWS_SESSION_TOKEN"]
print(json.dumps(out))' "$profile"
}

cmd_codex_keyring() {
  local cfg="$HOME/.codex/config.toml"
  mkdir -p "$HOME/.codex"
  if grep -qs '^cli_auth_credentials_store' "$cfg"; then
    echo "Codex already sets cli_auth_credentials_store in $cfg; left as is."
    return 0
  fi
  [[ -f "$cfg" ]] && cp -p "$cfg" "$cfg.bak.$(date +%Y%m%d%H%M%S)"
  # A top-level key must come before the first [table]
  python3 - "$cfg" <<'PYEOF'
import os, sys
path = sys.argv[1]
text = open(path).read() if os.path.exists(path) else ""
line = 'cli_auth_credentials_store = "keyring"  # set by `secret codex-keyring`\n'
open(path, "w").write(line + ("\n" if text and not text.startswith("\n") else "") + text)
PYEOF
  echo "Codex will keep its login in the OS keyring."
  echo "Next: codex logout && codex login (or printenv OPENAI_API_KEY | codex login --with-api-key),"
  echo "then check ~/.codex/auth.json is gone (codex logout removes it)."
}

cmd_doctor() {
  local ok=1 f p n
  for t in sops age-keygen python3; do
    command -v "$t" >/dev/null && echo "ok    $t installed" || { echo "FAIL  $t missing"; ok=0; }
  done
  if key_exists; then
    echo "ok    device key in $(pick_backend) ($(device_pubkey))"
  else
    echo "FAIL  no device key; run: secret init"; ok=0
  fi
  if [[ -d "$SECRETS_DIR" ]]; then
    echo "ok    store $SECRETS_DIR ($(grep -c '^[^#]' "$SECRETS_DIR/devices.txt" 2>/dev/null || echo 0) device(s))"
    git -C "$SECRETS_DIR" remote -v 2>/dev/null | grep -q github.com &&
      echo "WARN  store has a github.com remote: make sure the repo is private"
    if key_exists; then
      use_key
      for f in "$SECRETS_DIR"/*.env; do
        [[ -e "$f" ]] || continue
        p=$(basename "$f" .env)
        if n=$(decrypt_profile "$p" 2>/dev/null | grep -c '='); then
          echo "ok    $p: decrypts ($n values)"
        else
          echo "FAIL  $p: this device can't decrypt it (add it from a device that can)"; ok=0
        fi
      done
    fi
  else
    echo "FAIL  no store at $SECRETS_DIR; run: secret init"; ok=0
  fi
  # Plaintext credential files that could move into a profile
  for f in .env .vibe/.env .aws/credentials .codex/auth.json .claude/.credentials.json .netrc .git-credentials .claude-backends.env; do
    [[ -f "$HOME/$f" ]] && echo "INFO  plaintext ~/$f (secret import PROFILE ~/$f, then remove it)"
  done
  [[ $ok -eq 1 ]]
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;;
  pubkey) device_pubkey || die "no device key; run: secret init" ;;
  devices) grep -v '^#' "$SECRETS_DIR/devices.txt" 2>/dev/null || die "no store at $SECRETS_DIR" ;;
  add-device) shift; need sops sops; cmd_add_device "$@" ;;
  remove-device) shift; need sops sops; cmd_remove_device "$@" ;;
  import) shift; need sops sops; cmd_import "$@" ;;
  set) shift; need sops sops; use_key; cmd_set "$@" ;;
  unset) shift; need sops sops; use_key; cmd_unset "$@" ;;
  edit)
    shift; need sops sops; valid_profile "${1:-}"; use_key
    (cd "$SECRETS_DIR" && sops edit --input-type dotenv --output-type dotenv "$1.env") || exit 1
    store_commit "edit $1" "$1.env" ;;
  list) shift; cmd_list "$@" ;;
  get) shift; need sops sops; use_key; cmd_get "$@" ;;
  run) shift; need sops sops; use_key; cmd_run "$@" ;;
  env)
    shift; need sops sops; valid_profile "${1:-}"
    # For `while read ... done < <(secret env p)` in sourced scripts; never onto a screen
    [[ -t 1 ]] && die "secret env prints secrets; pipe it into a loader (secret get shows one value)"
    use_key; decrypt_profile "$1" ;;
  reencrypt) need sops sops; write_sops_yaml; reencrypt_all; echo "Re-encrypted every profile for: $(awk 'NF >= 2 && $1 !~ /^#/ {print $1}' "$SECRETS_DIR/devices.txt" | paste -sd' ' -)" ;;
  aws-credentials) shift; need sops sops; use_key; cmd_aws_credentials "$@" ;;
  codex-keyring) cmd_codex_keyring ;;
  doctor) cmd_doctor ;;
  ""|-h|--help|help) sed -n '2,32p' "$0" ;;
  *) die "unknown command $1 (secret --help)" ;;
esac
