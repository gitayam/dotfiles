#!/usr/bin/env python3
"""Bound one native OpenCode task and retain private evidence; never auto-retry."""
import argparse
import json
import math
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time


def bounded(argv, *, cwd, env, timeout, stdout, stderr):
    """Run a private process group, including a whole-group kill after deadline."""
    try:
        process = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                                   stdout=stdout, stderr=stderr, start_new_session=True)
    except OSError as exc:
        return {"exit": 127, "deadline_reached": False, "interrupted": False,
                "launch_error_type": type(exc).__name__}
    deadline = interrupted = False
    try:
        process.wait(timeout=timeout)
    except (subprocess.TimeoutExpired, KeyboardInterrupt) as exc:
        deadline = isinstance(exc, subprocess.TimeoutExpired)
        interrupted = not deadline
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            pass
        # A child may outlive a parent that handled SIGTERM. Reap the group too.
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()
    return {"exit": process.returncode, "deadline_reached": deadline,
            "interrupted": interrupted}


def collect_usage(binary, session, cwd, env, destination):
    # Capture in memory. Retain selected metadata only, never the transcript/auth.
    try:
        proc = subprocess.run([binary, "session", "export", "--standalone", "--sanitize", session],
                              cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                              capture_output=True, timeout=20)
        data = json.loads(proc.stdout) if proc.returncode == 0 else {}
        usage = [{k: m[k] for k in ("model", "tokens", "cost", "finish") if k in m}
                 for m in data.get("messages", []) if m.get("model")]
    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError, AttributeError):
        usage = []
    destination.write_text(json.dumps(usage, indent=2) + "\n")
    return usage


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cwd", type=Path, default=Path.cwd())
    parser.add_argument("--model", default="opencode-go/qwen3.7-plus")
    parser.add_argument("--agent", default="build")
    parser.add_argument("--timeout", type=float, required=True, help="Task deadline in seconds")
    parser.add_argument("--artifacts", type=Path, help="New private evidence directory")
    parser.add_argument("--auto", action="store_true", help="Approve asks; explicit denies remain")
    parser.add_argument("--check-command", help="Trusted independent checker argv as a JSON array; no shell")
    parser.add_argument("--check-timeout", type=float, default=30)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--prompt")
    source.add_argument("--prompt-file", type=Path)
    args = parser.parse_args()
    if not all(math.isfinite(t) and t > 0 for t in (args.timeout, args.check_timeout)):
        parser.error("Deadlines must be finite and positive")
    cwd = args.cwd.resolve(strict=True)
    if not cwd.is_dir():
        parser.error("cwd must be a directory")
    binary = shutil.which("opencode")
    if not binary:
        parser.error("OpenCode is not on PATH")
    check = None
    if args.check_command:
        try:
            check = json.loads(args.check_command)
        except ValueError:
            parser.error("check-command must be a JSON argv array")
        if not isinstance(check, list) or not check or not all(isinstance(x, str) and x for x in check):
            parser.error("check-command must contain nonempty argv strings")
    os.umask(0o077)
    if args.artifacts:
        evidence = args.artifacts.resolve()
        # Keep run evidence outside the agent's workspace, even if not an OS boundary.
        if evidence == cwd or evidence.is_relative_to(cwd):
            parser.error("artifacts must be outside cwd")
        evidence.mkdir(parents=True, mode=0o700, exist_ok=False)
    else:
        root = Path.home() / ".local/state/oc-task"
        root.mkdir(parents=True, mode=0o700, exist_ok=True)
        evidence = Path(tempfile.mkdtemp(prefix="run-", dir=root))
    prompt = args.prompt if args.prompt is not None else args.prompt_file.read_text()
    env = dict(os.environ, PWD=str(cwd))
    argv = [binary, "run", "--standalone", "--model", args.model,
            "--agent", args.agent, "--format", "json"]
    if args.auto:
        argv.append("--auto")
    argv.append(prompt)
    start = time.monotonic()
    with (evidence / "events.jsonl").open("wb") as out, (evidence / "stderr.txt").open("wb") as err:
        result = bounded(argv, cwd=cwd, env=env, timeout=args.timeout, stdout=out, stderr=err)
    events = []
    for line in (evidence / "events.jsonl").read_text(errors="replace").splitlines():
        try:
            event = json.loads(line)
            if isinstance(event, dict):
                events.append(event)
        except ValueError:
            continue
    session = next((e["sessionID"] for e in events if e.get("sessionID")), None)
    usage = collect_usage(binary, session, cwd, env, evidence / "usage.json") if session else []
    result.update(seconds=round(time.monotonic() - start, 3), cwd=str(cwd),
                  requested_model=args.model, agent=args.agent, session_id=session,
                  cli_attempts=1, retained_parent_model_turns=len(usage),
                  model_identities=sorted({m["model"].get("providerID", "") + "/" + m["model"].get("id", "") for m in usage}),
                  reported_cost=sum(m.get("cost", 0) or 0 for m in usage),
                  session_error_events=sum(e.get("type") == "error" for e in events),
                  acceptance="unchecked", artifacts=str(evidence))
    result["parent_cache_tokens"] = {
        key: sum((m.get("tokens", {}).get("cache", {}).get(key, 0) or 0) for m in usage)
        for key in ("read", "write")
    }
    if check and not result["interrupted"]:
        # A checker is trusted operator code. It is NOT a sandbox for generated code.
        with (evidence / "check.stdout").open("wb") as out, (evidence / "check.stderr").open("wb") as err:
            checked = bounded(check, cwd=cwd, env=env, timeout=args.check_timeout, stdout=out, stderr=err)
        result["check"] = checked
        result["acceptance"] = "passed" if checked["exit"] == 0 and not checked["deadline_reached"] and not checked["interrupted"] else "failed"
    result["complete"] = bool(check and result["acceptance"] == "passed" and result["exit"] == 0
                              and not result["deadline_reached"] and not result["interrupted"]
                              and not result["session_error_events"] and usage
                              and result["model_identities"] == [args.model.split("#")[0]])
    (evidence / "result.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result, indent=2))
    if result["deadline_reached"]:
        return 124
    if result["interrupted"]:
        return 130
    return 0 if result["complete"] else 2


if __name__ == "__main__":
    sys.exit(main())
