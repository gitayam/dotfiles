# ~/.ssh/config, from dotfiles shared/ssh/config.template. The setup scripts
# copy it only when ~/.ssh/config doesn't exist; edit freely. Put hosts in
# ~/.ssh/config.d/*.conf (one file per group of hosts) so this file stays generic.
# Check it with: ssh-doctor [host]

# Must come before any Host block: sshd reads Include where it appears
Include ~/.ssh/config.d/*.conf

# Example host (copy into ~/.ssh/config.d/servers.conf):
#   Host proxmox
#       HostName 100.x.y.z            # Tailscale address
#       User root
#       IdentityFile ~/.ssh/id_ed25519
#       IdentitiesOnly yes            # only if that file exists: it hides agent keys
#       ForwardAgent yes              # only for a host you trust; off by default below

Host *
    # Unknown on Linux; IgnoreUnknown must come first or Linux ssh rejects the file
    IgnoreUnknown UseKeychain
    UseKeychain yes
    AddKeysToAgent yes
    # A remote host can use your forwarded agent to log in elsewhere as you
    ForwardAgent no
    # Notice dead connections (Wi-Fi changes, sleep) within 2 minutes
    ServerAliveInterval 30
    ServerAliveCountMax 4
    # Reuse one connection per host: faster repeat ssh/scp/git; %C is a hash, so
    # long host names don't overflow the socket path
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m
    HashKnownHosts no
